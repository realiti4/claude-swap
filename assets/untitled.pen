                            },
                            {
                              "type": "text",
                              "id": "XkMxx",
                              "name": "TNote Click-outside, combined Body",
                              "fill": "$text-secondary",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "The two windows count as one surface. A click in either keeps both open, including clicking the main panel to switch accounts. A click outside both dismisses both together.",
                              "lineHeight": 1.45,
                              "fontFamily": "$font-ui",
                              "fontSize": 10,
                              "fontWeight": "normal"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "SED4s",
                      "name": "TNote Reduced motion",
                      "width": "fill_container",
                      "gap": 9,
                      "children": [
                        {
                          "type": "text",
                          "id": "LVnzb",
                          "name": "TNote Reduced motion Index",
                          "fill": "$accent-text",
                          "textGrowth": "fixed-width",
                          "width": 18,
                          "content": "T5",
                          "fontFamily": "$font-num",
                          "fontSize": 9.5,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "frame",
                          "id": "q2Ygu",
                          "name": "TNote Reduced motion Text",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 2,
                          "children": [
                            {
                              "type": "text",
                              "id": "m59N08",
                              "name": "TNote Reduced motion Title",
                              "fill": "$text-primary",
                              "content": "Reduced motion",
                              "fontFamily": "$font-ui",
                              "fontSize": 10.5,
                              "fontWeight": "600",
                              "letterSpacing": -0.1
                            },
                            {
                              "type": "text",
                              "id": "m8e7vR",
                              "name": "TNote Reduced motion Body",
                              "fill": "$text-secondary",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "The companion slides 140 ms from the main panel's edge. With Reduce Motion on it simply appears and disappears — no slide, no fade — and bars never animate between values; they redraw at the new length.",
                              "lineHeight": 1.45,
                              "fontFamily": "$font-ui",
                              "fontSize": 10,
                              "fontWeight": "normal"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "p8nIry",
                  "name": "Timeline Notes Column 2",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 10,
                  "children": [
                    {
                      "type": "frame",
                      "id": "gdgM1",
                      "name": "TNote Remaining time, not usage",
                      "width": "fill_container",
                      "gap": 9,
                      "children": [
                        {
                          "type": "text",
                          "id": "yhkFB",
                          "name": "TNote Remaining time, not usage Index",
                          "fill": "$accent-text",
                          "textGrowth": "fixed-width",
                          "width": 18,
                          "content": "T6",
                          "fontFamily": "$font-num",
                          "fontSize": 9.5,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "frame",
                          "id": "g48Ua",
                          "name": "TNote Remaining time, not usage Text",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 2,
                          "children": [
                            {
                              "type": "text",
                              "id": "L7VVfw",
                              "name": "TNote Remaining time, not usage Title",
                              "fill": "$text-primary",
                              "content": "Window and quota, not elapsed",
                              "fontFamily": "$font-ui",
                              "fontSize": 10.5,
                              "fontWeight": "600",
                              "letterSpacing": -0.1
                            },
                            {
                              "type": "text",
                              "id": "PlxXI",
                              "name": "TNote Remaining time, not usage Body",
                              "fill": "$text-secondary",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "The whole bar is one full window — 5 hours or 7 days — positioned by time on a shared axis, so its left edge is the window start and its right edge the reset. The coloured fill is the percentage of quota used in that window; its end is a quantity, not a moment, and never marks a time event.",
                              "lineHeight": 1.45,
                              "fontFamily": "$font-ui",
                              "fontSize": 10,
                              "fontWeight": "normal"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "SXuNM",
                      "name": "TNote Only the next reset",
                      "width": "fill_container",
                      "gap": 9,
                      "children": [
                        {
                          "type": "text",
                          "id": "w6yU8",
                          "name": "TNote Only the next reset Index",
                          "fill": "$accent-text",
                          "textGrowth": "fixed-width",
                          "width": 18,
                          "content": "T7",
                          "fontFamily": "$font-num",
                          "fontSize": 9.5,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "frame",
                          "id": "e8QBpE",
                          "name": "TNote Only the next reset Text",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 2,
                          "children": [
                            {
                              "type": "text",
                              "id": "O2v0iC",
                              "name": "TNote Only the next reset Title",
                              "fill": "$text-primary",
                              "content": "Only the next reset",
                              "fontFamily": "$font-ui",
                              "fontSize": 10.5,
                              "fontWeight": "600",
                              "letterSpacing": -0.1
                            },
                            {
                              "type": "text",
                              "id": "n3qQwR",
                              "name": "TNote Only the next reset Body",
                              "fill": "$text-secondary",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Only the window that is currently running is drawn — the one ending at the next known reset. The chart never extrapolates the cycle after it. Where the service reports no start, the start is inferred as reset minus the window length and labelled as inferred in the row detail.",
                              "lineHeight": 1.45,
                              "fontFamily": "$font-ui",
                              "fontSize": 10,
                              "fontWeight": "normal"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "zLv9G",
                      "name": "TNote Selecting never switches",
                      "width": "fill_container",
                      "gap": 9,
                      "children": [
                        {
                          "type": "text",
                          "id": "iXKSq",
                          "name": "TNote Selecting never switches Index",
                          "fill": "$accent-text",
                          "textGrowth": "fixed-width",
                          "width": 18,
                          "content": "T8",
                          "fontFamily": "$font-num",
                          "fontSize": 9.5,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "frame",
                          "id": "d0Dzl",
                          "name": "TNote Selecting never switches Text",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 2,
                          "children": [
                            {
                              "type": "text",
                              "id": "H8sPd",
                              "name": "TNote Selecting never switches Title",
                              "fill": "$text-primary",
                              "content": "Selecting never switches",
                              "fontFamily": "$font-ui",
                              "fontSize": 10.5,
                              "fontWeight": "600",
                              "letterSpacing": -0.1
                            },
                            {
                              "type": "text",
                              "id": "vJzYr",
                              "name": "TNote Selecting never switches Body",
                              "fill": "$text-secondary",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Clicking or focusing a row highlights it and can open its detail. It never changes the active account. Switching stays in the main panel, exactly as on artboards 12–13.",
                              "lineHeight": 1.45,
                              "fontFamily": "$font-ui",
                              "fontSize": 10,
                              "fontWeight": "normal"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "RYCxq",
                      "name": "TNote Stale and elapsed",
                      "width": "fill_container",
                      "gap": 9,
                      "children": [
                        {
                          "type": "text",
                          "id": "TtAve",
                          "name": "TNote Stale and elapsed Index",
                          "fill": "$accent-text",
                          "textGrowth": "fixed-width",
                          "width": 18,
                          "content": "T9",
                          "fontFamily": "$font-num",
                          "fontSize": 9.5,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "frame",
                          "id": "A517T",
                          "name": "TNote Stale and elapsed Text",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 2,
                          "children": [
                            {
                              "type": "text",
                              "id": "hcJWr",
                              "name": "TNote Stale and elapsed Title",
                              "fill": "$text-primary",
                              "content": "Stale and elapsed",
                              "fontFamily": "$font-ui",
                              "fontSize": 10.5,
                              "fontWeight": "600",
                              "letterSpacing": -0.1
                            },
                            {
                              "type": "text",
                              "id": "uRh5x",
                              "name": "TNote Stale and elapsed Body",
                              "fill": "$text-secondary",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "A stale account keeps its last known window as a muted outline with its last known quota fill, labelled last known. Once the reset time has passed with no fresh read the row reads Awaiting updated usage and draws nothing, rather than inventing the following cycle. A window that is known while its usage is not shows the neutral bar with no fill and reads no usage data.",
                              "lineHeight": 1.45,
                              "fontFamily": "$font-ui",
                              "fontSize": 10,
                              "fontWeight": "normal"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "Ah73K",
                      "name": "TNote Timezone and sizes",
                      "width": "fill_container",
                      "gap": 9,
                      "children": [
                        {
                          "type": "text",
                          "id": "yKMcm",
                          "name": "TNote Timezone and sizes Index",
                          "fill": "$accent-text",
                          "textGrowth": "fixed-width",
                          "width": 18,
                          "content": "T10",
                          "fontFamily": "$font-num",
                          "fontSize": 9.5,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "frame",
                          "id": "oU5Qa",
                          "name": "TNote Timezone and sizes Text",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 2,
                          "children": [
                            {
                              "type": "text",
                              "id": "s323XA",
                              "name": "TNote Timezone and sizes Title",
                              "fill": "$text-primary",
                              "content": "Timezone and sizes",
                              "fontFamily": "$font-ui",
                              "fontSize": 10.5,
                              "fontWeight": "600",
                              "letterSpacing": -0.1
                            },
                            {
                              "type": "text",
                              "id": "Q13L1h",
                              "name": "TNote Timezone and sizes Body",
                              "fill": "$text-secondary",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "The header states the Now time and the IANA zone; every exact time in a row or detail is in that zone. No label anywhere in the companion is below 12px, and the axis never carries more labels than it can space out.",
                              "lineHeight": 1.45,
                              "fontFamily": "$font-ui",
                              "fontSize": 10,
                              "fontWeight": "normal"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
